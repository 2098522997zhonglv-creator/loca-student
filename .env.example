# All storage is local by default: SQLite + embedded Qdrant.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-local-random-secret
# Include the Windows LAN IP used for remote browser access.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.32.138
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://192.168.32.138:8000
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://192.168.32.138:5173
TIME_ZONE=Asia/Shanghai
LOG_LEVEL=INFO

# Leave QDRANT_URL unset to use ./data/qdrant.
QDRANT_LOCAL_PATH=./data/qdrant
# QDRANT_URL=http://127.0.0.1:6333

# Initial local administrator, used by scripts/setup.sh.
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@example.com
DJANGO_ADMIN_PASSWORD=change-me-now
# Optional. If empty, a cryptographically random API key is generated.
KNOWLEDGE_CENTER_API_KEY=

# Configure the actual chat and embedding endpoints in the web UI after login.
# OpenAI-compatible local examples: Ollama, Xinference, vLLM, LM Studio.
